0
"26.1.2"...
../blueprints/alpha-r0/main.xcshoper
../materials/alpha-r0-26.3
[
    "欢迎使用 Alpha r0 模板，此模板为标准商店模板，提供对普通方块容器的支持。\nAlpha r0 生成的数据包包含大量高版本引入的指令特性，因此功能较为完善，且性能较高，但对版本的要求也更高。",
    "注册你的商店后，在游戏中通过\"/function [命名空间]:_summon/[注册名]\" 来加载它，加载时将会在玩家站立的位置生成一个商店容器。\nAlpha r0 为每一商店都设置了独立的ID，并会在玩家每次打开它时依靠ID定位此商店。\n因此商店容器不能被手动放置，否则商店无法被正常加载。如果需要修改商店方块的状态，请使用调试棒。",
    "Alpha r0 会在商店容器位置生成一个marker，并且在容器被破坏后不会被清除，造成实体残留。\n这可能会导致后续在原位置加载的商店重复触发执行或导致游戏卡顿。\n因此在必要时输入\"/function [命名空间]:clear_marker\"来清除残留的marker。",
    "Alpha r0 支持布局输入器，通过指令\"function [命名空间]:input/[注册名]/[输入器名]\"来获取玩家最后一次打开的商店中布局的输入。",
    "Alpha r0 模板存在以下受限的特性：",
    "   1. Alpha r0 不支持末影箱或大型箱子；",
    "   2. Alpha r0 的栏位为非动态更新，因此无法在计分板分数发生变化时立即更新栏位的物品；但在每次商店内交互后可以对计分板分数的变化进行响应；",
    "   3. Alpha r0 在物品操作组以栏位筛选为条件时，对于同一栏位仅会执行第一个触发器。"
]
foreach (Shop[]) {
    if (containerType == "ender_chest" || containerType == "large_chest"
        || containerType == "large_trapped_chest") {
        error("Alpha r0 不支持末影箱或大型箱子。", "请选择末影箱、大型箱子和大型陷阱箱以外的容器。");
    }
    foreach (slots[]) {
        foreach (items[]) {
            if (count < 1) { error("商品数量必须大于 0。"); }
            foreach (operations[]) {
                if (@parent[0].count == 1 && trigger.mode.kind == "take_item"
                    && trigger.mode.filter.kind == "quantity") {
                    warning("商品数量为 1 时使用了数量筛选。",
                        "单个商品无法区分整组与部分取得，部分数量筛选可能永远无法触发；请检查数量或改用无筛选。"
                    );
                }
                if (trigger.mode.kind == "take_item" && trigger.mode.filter.kind == "slot"
                    && (int(trigger.mode.filter.slot) < 0 || int(trigger.mode.filter.slot) > 35)) {
                    error("玩家物品栏槽位超出 0 到 35。", "请选择快捷栏或背包中的有效槽位。");
                }
                if (trigger.mode.kind == "take_item" && trigger.mode.filter.kind == "quantity"
                    && trigger.mode.filter.mode == "custom"
                    && (int(trigger.mode.filter.amount) < 1 || int(trigger.mode.filter.amount) > 2147483647)) {
                    error("自定义触发数量必须是正的 32 位整数。");
                }
                foreach (cost[]) {
                    if (int(amount) < 0 || int(amount) > 2147483647) {
                        error("代价数量超出 0 到 2147483647。", "请使用 Minecraft 指令允许的非负 32 位整数。");
                    }
                }
            }
        }
    }
    foreach (layoutInputGroups[]) {
        if (int(defaultValue) < -2147483648 || int(defaultValue) > 2147483647) { error("布局默认值超出 32 位计分板整数范围。"); }
        foreach (connections[]) {
            if (int(value) < -2147483648 || int(value) > 2147483647) { error("布局匹配值超出 32 位计分板整数范围。"); }
        }
    }
}
