{{itemPath}}/set.mcfunction
data modify block ~ ~ ~ Items[{Slot:{{slotNumber}}b}].components."minecraft:custom_data".xca set value {token:1b,shop:"{{shopName}}",product:"{{productKey}}"}
data modify block ~ ~ ~ Items[{Slot:{{slotNumber}}b}].components."minecraft:custom_data".xca.id set from block ~ ~ ~ components."minecraft:custom_data".xca.id
return 1
