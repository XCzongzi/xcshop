detection.mcfunction
scoreboard players set #source _xca 1
scoreboard players set #handled _xca 0
tag @s add xca.buyer
summon item_display ~ ~ ~ {Tags:["xca.cursor"],view_range:0f}
item replace entity @e[type=item_display,tag=xca.cursor,limit=1] contents from entity @s player.cursor
execute if function xcshop_alpha:locate at @e[type=marker,tag=xca.shop,distance=..8] if score @n[type=marker,tag=xca.shop] _xca = @s _xca run function xcshop_alpha:shop
execute if score #handled _xca matches 0 run clear @s *[custom_data~{xca:{token:1b}}]
kill @e[type=item_display,tag=xca.cursor]
tag @s remove xca.buyer
