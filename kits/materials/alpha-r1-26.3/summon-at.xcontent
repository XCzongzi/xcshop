_summon/{{shopName}}/at.mcfunction
# Refuse to overwrite existing blocks or allocate an overflowing persistent ID.
execute unless block ~ ~ ~ air unless block ~ ~ ~ cave_air unless block ~ ~ ~ void_air run return fail
execute if score #next _xca matches 2147483647 run return fail
setblock ~ ~ ~ {{blockName}}
summon marker ~0.5 ~ ~0.5 {Tags:["xca.shop","xca.shop.{{shopName}}","xca.new"]}
scoreboard players operation @e[type=marker,tag=xca.new,limit=1,distance=..1] _xca = #next _xca
data modify block ~ ~ ~ components."minecraft:custom_data".xca set value {shop:"{{shopName}}"}
execute store result block ~ ~ ~ components."minecraft:custom_data".xca.id int 1 run scoreboard players get #next _xca
data modify block ~ ~ ~ components."minecraft:custom_name" set value {{shopTitle}}
scoreboard players add #next _xca 1
tag @e[type=marker,tag=xca.new] remove xca.new
function xcshop_alpha:shop/{{shopName}}/set
return 1
