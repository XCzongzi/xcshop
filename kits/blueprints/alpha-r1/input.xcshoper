string inputName = id;
string inputClause = "";
if (!empty(filter.scoreboard)) { inputClause = "if score " + filter.target + " " + filter.scoreboard + " matches " + filter.score + " "; }
build "input-base.xclist"
if (!empty(filter.scoreboard)) { build "filter-objective.xcontent" }
foreach (connections[]) {
    int connectionNumber = @index;
    build "input-route.xcontent"
    foreach (slots[]) {
        int inputSlotNumber = index;
        if (items.length == 0) { build "input-empty.xcontent" }
        else {
            foreach (items[]) {
                string stackText = item;
                build "spec.xcshoper"
                build "input-item.xcontent"
            }
        }
    }
    build "input-match-end.xcontent"
}
build "input-default.xcontent"
