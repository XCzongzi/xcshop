if (feedbackText != "") {
    string feedbackJson = json(feedbackText);
    if (startsWith(trim(feedbackText), "{") || startsWith(trim(feedbackText), "[")) { feedbackJson = feedbackText; }
    build "feedback-text.xcontent"
}
if (feedbackSound != "") { build "feedback-sound.xcontent" }
build "feedback-end.xcontent"
