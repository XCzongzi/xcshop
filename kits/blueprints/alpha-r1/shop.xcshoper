build "shop-base.xclist"
content opening openCommand ("opened/" + shopName + ".mcfunction")
build opening
build "opened-refresh.xcontent"
build "shop-routing.xcontent"
foreach (layoutInputGroups[]) {
    string inputClause = "";
    if (!empty(filter.scoreboard)) { inputClause = "if score " + filter.target + " " + filter.scoreboard + " matches " + filter.score + " "; }
    build "input.xcshoper"
    build "input-shop-call.xcontent"
}
foreach (slots[]) {
    int slotNumber = index;
    bool inputSlot = false;
    foreach (@parent[0].layoutInputGroups[]) {
        if (contains(slots, slotNumber)) { inputSlot = true; }
    }
    if (!inputSlot) {
        build "slot-base.xcontent"
        if (@parent[0].placeholderItem != "") { build "placeholder.xcontent" }
        foreach (items[]) {
            int productNumber = @index;
            string productKey = string(slotNumber) + ":" + productNumber;
            string filterClause = "";
            if (!empty(filter.scoreboard)) { filterClause = "if score " + filter.target + " " + filter.scoreboard + " matches " + filter.score + " "; }
            build "item.xcshoper"
        }
        build "slot-set-end.xcontent"
        build "shop-slot-set.xcontent"
    }
    build "return-slot.xcontent"
}
build "return-end.xcontent"
build "shop-sell-end.xcontent"
